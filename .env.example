# Production site URL (used for canonical links, sitemap, robots.txt, and OG metadata)
NEXT_PUBLIC_SITE_URL="https://lincolnshirekneeclinic.co.uk"

# Business Dashboard HTTP Basic Authentication Credentials
DASHBOARD_USER="admin"
DASHBOARD_PASSWORD="your-long-random-password-here"

# Supabase Production Database Credentials (EU Frankfurt Region)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Microsoft Clarity Web Analytics (Optional)
NEXT_PUBLIC_CLARITY_PROJECT_ID="your-clarity-project-id-here"

# Serper.dev API key — powers the "Suggested Evidence Sources" web-search panel
# in the clinical review dashboard (/portal/business, Clinical Review tab).
# Get a key at https://serper.dev
SERPER_API_KEY="your-serper-api-key-here"
